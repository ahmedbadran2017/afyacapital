<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title | default: page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page.meta_description | default: 'Afya Capital is a diversified healthcare holding company developing, operating, and co-investing in high-growth hospital ventures across Africa.' }}">
  <meta name="theme-color" content="#082048">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ page.title | default: page_title }} — {{ shop.name }}">
  <meta property="og:description" content="{{ page.meta_description | default: 'A US-based holding company developing, operating, and co-investing in hospitals across Africa. 40+ hospitals managed; 5 active markets; institutional partners welcome.' }}">
  <meta property="og:type" content="website">

  <!-- Required by Shopify -->
  {{ content_for_header }}

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Fonts: Cormorant Garamond + Public Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">

  <!-- Landing Page Styles -->
  {{ 'afya-landing.css' | asset_url | stylesheet_tag }}
</head>
<body>
  {{ content_for_layout }}

  <!-- Landing Page JS -->
  <script src="{{ 'afya-landing.js' | asset_url }}" defer></script>
</body>
</html>
