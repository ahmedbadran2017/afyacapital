<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | escape }}">
  <meta name="theme-color" content="#08111e">

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ page_title }} — {{ shop.name }}">
  <meta property="og:description" content="{{ page_description | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ 'og-image.jpg' | asset_url }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }} — {{ shop.name }}">
  <meta name="twitter:description" content="{{ page_description | escape }}">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="{{ 'logo-afya-icon.svg' | asset_url }}">

  <!-- Required by Shopify -->
  {{ content_for_header }}

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500&display=swap" rel="stylesheet">

  <!-- Styles -->
  {{ 'afya-landing.css' | asset_url | stylesheet_tag }}

  <!-- Theme Settings → CSS Variables -->
  <style>
    :root {
      --teal: {{ settings.color_primary | default: '#0e7c6e' }};
      --gold: {{ settings.color_secondary | default: '#c8963e' }};
      --deep: {{ settings.color_background | default: '#08111e' }};
      --cream: {{ settings.color_text | default: '#f4efe6' }};
    }
  </style>

  <!-- Noscript fallback -->
  <noscript>
    <style>.animate-on-scroll { opacity: 1; transform: none; }</style>
  </noscript>
</head>
<body>
  <!-- Skip to content -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- NAV -->
  <nav aria-label="Main navigation">
    <a href="/" class="nav-logo">
      <img src="{{ 'logo-afya-icon.svg' | asset_url }}" alt="Afya Capital" class="logo-mark" width="40" height="40">
      <div class="logo-text-group">
        <div class="logo-name">Afya <span>Capital</span></div>
        <div class="logo-tagline">Healthcare Investment</div>
      </div>
    </a>
    <div class="nav-links" id="navLinks">
      <a href="/#about">About</a>
      <a href="/#network">Our Network</a>
      <a href="/#partnerships">Partnerships</a>
      <a href="/#expertise">Expertise</a>
      <a href="/#contact" class="nav-cta">Invest With Us</a>
    </div>
    <button type="button" class="nav-hamburger" id="menuToggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="footer-logo">
      <img src="{{ 'logo-afya-icon.svg' | asset_url }}" alt="Afya Capital" class="logo-mark" width="40" height="40">
      <div class="logo-text-group">
        <div class="logo-name">Afya <span>Capital</span></div>
        <div class="logo-tagline">Healthcare Investment</div>
      </div>
    </div>
    <div class="footer-links">
      <a href="mailto:invest@afyacapital.com">invest@afyacapital.com</a>
      <span class="footer-sep">&middot;</span>
      <span>Delaware, USA</span>
    </div>
    <p>&copy; {{ 'now' | date: '%Y' }} Afya Capital LLC. All rights reserved.</p>
  </footer>

  <!-- JS -->
  <script src="{{ 'afya-landing.js' | asset_url }}" defer></script>
</body>
</html>
