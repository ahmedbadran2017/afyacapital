<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title | default: page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page.meta_description | default: 'Afya Capital is a diversified healthcare holding company developing, operating, and co-investing in high-growth hospital ventures across Africa.' }}">
  <meta name="theme-color" content="#fa510f">

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ page.title | default: page_title }} — {{ shop.name }}">
  <meta property="og:description" content="{{ page.meta_description | default: 'A diversified healthcare holding company developing, operating, and co-investing in high-growth hospital ventures across Africa.' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ 'og-image.jpg' | asset_url }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page.title | default: page_title }} — {{ shop.name }}">
  <meta name="twitter:description" content="{{ page.meta_description | default: 'Healthcare investment partner developing hospital ventures across Africa.' }}">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="{{ 'logo-afya-icon.svg' | asset_url }}">

  <!-- Required by Shopify -->
  {{ content_for_header }}

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Font: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap" rel="stylesheet">

  <!-- Landing Page Styles -->
  {{ 'afya-landing.css' | asset_url | stylesheet_tag }}

  <!-- Theme Settings → CSS Variables -->
  <style>
    :root {
      --main: {{ settings.color_primary | default: '#fa510f' }};
      --main-hover: {{ settings.color_secondary | default: '#e04500' }};
      --black: {{ settings.color_background | default: '#101824' }};
      --white: {{ settings.color_text | default: '#ffffff' }};
    }
  </style>

  <!-- Noscript fallback: show hidden sections if JS disabled -->
  <noscript>
    <style>.animate-on-scroll { opacity: 1; transform: none; }</style>
  </noscript>
</head>
<body>
  <!-- Skip to content -->
  <a href="#hero" class="skip-link">Skip to main content</a>

  {{ content_for_layout }}

  <!-- Landing Page JS -->
  <script src="{{ 'afya-landing.js' | asset_url }}" defer></script>
</body>
</html>
